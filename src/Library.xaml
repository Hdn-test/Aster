<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LibraryPage" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="LibraryTitle" Text="Thư viện ảnh" Style="{DynamicResource Title}"/><TextBlock x:Name="LibrarySubtitle" Text="Các mục đã thêm được lưu đến khi bạn gỡ khỏi thư viện." Style="{DynamicResource Subtitle}"/></StackPanel>
 <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="LibrarySaved" Content="Đã lưu"/><Button x:Name="LibraryScanned" Content="Kết quả quét"/><Button x:Name="LibraryRefresh" Content="Quét nguồn"/><Button x:Name="LibraryAdd" Content="+ Nguồn quét"/><Button x:Name="LibraryStop" Content="Dừng quét"/></WrapPanel>
 <WrapPanel Grid.Row="2" Margin="0,0,0,12"><Button x:Name="LibraryAddFile" Content="+ Thêm file" Background="{DynamicResource PrimaryFill}" Foreground="#101A2B"/><Button x:Name="LibrarySaveSelection" Content="Lưu mục đã chọn" Visibility="Collapsed"/><Button x:Name="LibraryRemove" Content="Gỡ khỏi thư viện"/><Button x:Name="LibraryRename" Content="Tên hiển thị"/><Button x:Name="LibraryCollection" Content="Bộ sưu tập"/><Button x:Name="LibraryFavorite" Content="Yêu thích"/><Button x:Name="LibraryReveal" Content="Mở vị trí"/><Button x:Name="GameDetails" Content="Game trong thư mục" Visibility="Collapsed"/></WrapPanel>
 <StackPanel Grid.Row="3" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox x:Name="LibrarySearch" ToolTip="Tìm theo tên, bộ sưu tập hoặc đường dẫn"/><CheckBox x:Name="LibraryOnlyFavorites" Grid.Column="1" Content="Chỉ yêu thích" Margin="16,0,0,0"/></Grid><TextBlock x:Name="LibrarySources" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/><WrapPanel x:Name="OfficeFilters" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="OfficeAll" Content="Office"/><Button x:Name="OfficeWord" Content="Word"/><Button x:Name="OfficeExcel" Content="Excel"/><Button x:Name="OfficeSlides" Content="PowerPoint"/><Button x:Name="OfficePdf" Content="PDF"/></WrapPanel></StackPanel>
 <DataGrid x:Name="LibraryList" Grid.Row="4" RowHeight="60" AllowDrop="True"><DataGrid.Columns><DataGridTemplateColumn Header="Tên" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Bộ sưu tập" Binding="{Binding Collection}" Width="120"/><DataGridTextColumn Header="Vị trí gốc" Binding="{Binding Context}" Width="1.6*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Availability}" Width="120"/><DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="100"/></DataGrid.Columns></DataGrid>
 <TextBlock x:Name="LibraryStatus" Grid.Row="5" Text="Thêm file hoặc kéo thả vào đây để lưu liên kết. Nhấp đúp để mở." Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
</Grid>

