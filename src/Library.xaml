<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LibraryPage" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="LibraryTitle" Text="Thư viện ảnh" Style="{DynamicResource Title}"/><TextBlock x:Name="LibrarySubtitle" Text="Ảnh cá nhân và ảnh tải xuống. Tài nguyên ứng dụng được giữ riêng." Style="{DynamicResource Subtitle}"/></StackPanel>
 <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="LibraryRefresh" Content="Quét thư viện" Background="{DynamicResource PrimaryFill}" Foreground="#101A2B"/><Button x:Name="LibraryAdd" Content="+ Thêm thư mục"/><Button x:Name="LibraryLaunch" Content="Mở file"/><Button x:Name="LibraryReveal" Content="Mở thư mục gốc"/><Button x:Name="GameDetails" Content="Game trong thư mục" Visibility="Collapsed"/><Button x:Name="LibraryStop" Content="Dừng"/></WrapPanel>
 <StackPanel Grid.Row="2" Margin="0,0,0,16"><TextBlock x:Name="LibrarySources" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/><WrapPanel x:Name="OfficeFilters" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="OfficeAll" Content="Office · Tất cả"/><Button x:Name="OfficeWord" Content="W  Word"/><Button x:Name="OfficeExcel" Content="X  Excel"/><Button x:Name="OfficeSlides" Content="P  PowerPoint"/><Button x:Name="OfficePdf" Content="PDF"/></WrapPanel></StackPanel>
 <DataGrid x:Name="LibraryList" Grid.Row="3" RowHeight="62"><DataGrid.Columns><DataGridTemplateColumn Header="Tên" Width="*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="34" Height="34" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Thư mục / ngữ cảnh" Binding="{Binding Context}" Width="2*"/><DataGridTextColumn Header="Sửa đổi" Binding="{Binding Date}" Width="155"/><DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="105"/></DataGrid.Columns></DataGrid>
 <TextBlock x:Name="LibraryStatus" Grid.Row="4" Text="Bấm Quét thư viện để đọc nguồn. Không di chuyển dữ liệu." Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
</Grid>

